  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": [
            "video/*",
            "image/*",
            ".mp4",
            ".mov",
            ".webm",
            ".m4v",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp"
          ]
        }
      ]
    }
  },
  "id": "./",
  "categories": [
    "productivity",
    "utilities",
    "photo",
    "video"
  ],
  "screenshots": [
    {
      "src": "assets/screenshot-welcome.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Welcome to HalalFrame"
    },
    {
      "src": "assets/screenshot-editor.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Private AI media editor"
    },
    {
      "src": "assets/screenshot-audio.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "On-device audio options"
    }
  ]
