      "purpose": "any"
    },
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-256.png",
      "sizes": "256x256",
      "type": "image/png",
      "purpose": "any"
